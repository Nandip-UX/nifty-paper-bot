# copy to .env and fill in the broker you use
# broker: zerodha | upstox | dhan | angel | yahoo (yahoo = paper trading with no account)
BROKER=zerodha
# paper mode only: override the balance read from the broker
# PAPER_CAPITAL=150000

# research agent (optional): Claude with live web search, ~1 call a day
ANTHROPIC_API_KEY=

# Zerodha Kite Connect (paid plan, Rs 500/month, for market data)
KITE_API_KEY=
KITE_API_SECRET=

# Upstox
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=

# Dhan (leave the token blank: the bot asks for today's token at login)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Angel One SmartAPI
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
